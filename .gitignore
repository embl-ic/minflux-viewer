.ruff_cache/
# sandboxed pytest tmp_path basetemp (pytest-of-*)
.tmp/
# ad-hoc pytest basetemp dirs (--basetemp=.pytest-<name>)
.pytest-*/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Local AI-agent guidance/setup only; do not publish to the remote repository
CLAUDE.md
AGENTS.md
agents.md
claude.md
BACKLOG.md
.claude/
.codex_backups/
# docs/ holds working notes and is ignored, except the published API reference.
# "docs/*" rather than "docs/": git cannot re-include a file whose directory is
# itself ignored.
docs/*
!docs/scripting-api.md

# MATLAB remnants
*.asv
*.m~

# Release build artifacts - publish via GitHub Releases, never commit"
MINFLUX-Viewer-*.zip
MINFLUX-Viewer-*.tar.gz
MINFLUX-Viewer-*.dmg

# Local benchmark / round-trip scratch output
output/
rt/
tmp/
*.junit.xml

# Generated by tools/vendor_pip.py; build input, not source.
resources/pip/
