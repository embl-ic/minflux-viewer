# Track large vendor binaries with Git LFS so they don't bloat the repo history.
# Run `git lfs install` once before the first push if your remote supports LFS.
vendor/*.whl filter=lfs diff=lfs merge=lfs -text

# Normalise line endings for text files
*.py    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf

# Binaries — no line-ending conversion
# ⚠ Images MUST be marked binary. Without a rule here autocrlf treats a PNG as
# text and strips its  bytes on checkout, silently corrupting the file -- which
# is what happened to resources/icons/multipoint.png (560 -> 116 bytes).
*.png   binary
*.ico   binary
*.icns  binary
*.tif   binary
*.tiff  binary

*.whl   binary
*.pyd   binary
*.dll   binary
*.so    binary
*.pyc   binary
